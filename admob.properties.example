# Copy to admob.properties (same folder) and paste your real AdMob ids.
# Only RELEASE builds read this file; debug builds always use Google's test ids.
# Any key left empty/placeholder falls back to the test id (see app/build.gradle.kts).

# AdMob > Apps > Epic Hypernova > App settings > App ID
appId=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY

# AdMob > Apps > Epic Hypernova > Ad units
banner=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
interstitial=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
rewarded=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY

# Public URL of docs/privacy-policy.html (shown in Settings). Empty = link hidden.
privacyPolicyUrl=
